# Configuration Firebase (OPTIONNELLE).
# Sans ces variables, l'application fonctionne integralement en local
# (IndexedDB) : voir docs/TECHNICAL_SPEC.md, section "Backends".
#
# ATTENTION : ces valeurs ne sont PAS des secrets (elles sont publiques cote
# client). Les vrais secrets restent dans les regles Firebase. Ne jamais
# committer de cle de service, de token ou de mot de passe (CLAUDE.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Prefixe de deploiement (GitHub Pages = /Pokexplo/)
BASE_PATH=/Pokexplo/
